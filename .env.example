# ─────────────────────────────────────────────────────────────
#  Variables d'environnement LALZIN
#  NE JAMAIS committer .env.local (gitignoré).
#  En production : Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Admin (/admin) ───────────────────────────────────────────
# Génère ADMIN_PASSWORD_HASH + AUTH_SECRET avec :  npm run set-admin
ADMIN_USERNAME=lalzin
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# ── Supabase (persistance du contenu / CMS live) ─────────────
# Depuis ton projet Supabase → Settings → API :
#   SUPABASE_URL = "Project URL"
#   La clé serveur = la "secret key" (sb_secret_…) OU l'ancienne "service_role".
#   ⚠️ PAS la clé "publishable"/"anon" → elle est bloquée en écriture (RLS).
#   ⚠️ Ne JAMAIS préfixer par NEXT_PUBLIC (clé secrète, côté serveur only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# (alias accepté : SUPABASE_SECRET_KEY=)

# ── Groove Knobs : téléchargement des plugins ────────────────
# Emails transactionnels + newsletter (resend.com)
RESEND_API_KEY=
# Audience Resend pour la case « newsletter » (Audiences → copier l'ID)
RESEND_AUDIENCE_ID=

# Secret de signature des liens de téléchargement (HMAC-SHA256).
# Génère-le avec :  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_TOKEN_SECRET=

# Stockage privé des .pkg / .exe (Cloudflare R2)
# Colle l'URL « S3 API » du bucket (Cloudflare → R2 → ton bucket → Settings).
# Le /<bucket> à la fin est retiré tout seul. Obligatoire si le bucket est en
# juridiction européenne (hôte en .eu.r2.cloudflarestorage.com).
R2_ENDPOINT=
# Alternative à R2_ENDPOINT : l'identifiant de compte seul (endpoint standard).
R2_ACCOUNT_ID=
# Cloudflare → R2 → Account details → API Tokens → Manage → Create token.
# Permission « Object Read only » : le site ne fait que LIRE (liens présignés),
# il n'écrit jamais dans le bucket. Prends « Object Read & Write » seulement si
# tu veux uploader avec ce même jeton.
# L'écran de création affiche trois valeurs : ignore le « Token value »
# (réservé à l'API REST Cloudflare) et reporte les deux autres ci-dessous.
# Le Secret Access Key (alias « Client Secret ») n'est affiché QU'UNE FOIS.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=groove-knobs

# Anti-robot (Cloudflare Turnstile). Sans ces clés, le captcha est
# simplement désactivé : honeypot et quotas restent actifs.
# La « site key » s'affiche forcément dans le HTML (c'est le principe du
# widget) mais elle est lue côté serveur puis passée au composant : pas
# besoin de préfixe NEXT_PUBLIC. Le secret, lui, ne sort jamais du serveur.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dons : identifiant paypal.me UNIQUEMENT (ex. « lalzin » pour paypal.me/lalzin)
PAYPAL_ME=
